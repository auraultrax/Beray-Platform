```javascript id="f3m7x2"
rules_version = '2';

service cloud.firestore {

    match /databases/{database}/documents {


        /* =================================================
           YARDIMCI FONKSİYONLAR
        ================================================= */

        function signedIn() {

            return request.auth != null;

        }


        function currentUser() {

            return get(
                /databases/$(database)
                /documents/users/$(request.auth.uid)
            );

        }


        function isAdmin() {

            return signedIn()
                &&
                currentUser().data.role
                == "admin";

        }


        function isTeacher() {

            return signedIn()
                &&
                currentUser().data.role
                in ["teacher","admin"];

        }


        function isStudent() {

            return signedIn()
                &&
                currentUser().data.role
                == "student";

        }



        /* =================================================
           USERS
        ================================================= */

        match /users/{userId} {


            /*
             * Kayıt olan kullanıcı yalnızca
             * kendisi için öğrenci profili oluşturabilir.
             */

            allow create:

                if signedIn()
                &&
                request.auth.uid == userId
                &&
                request.resource.data.role
                == "student";


            /*
             * Kullanıcı kendi profilini,
             * öğretmen/admin bütün öğrenci
             * profillerini okuyabilir.
             */

            allow read:

                if signedIn()
                &&
                (
                    request.auth.uid == userId
                    ||
                    isTeacher()
                );


            /*
             * Öğretmen/admin rol bilgilerini
             * yönetebilir.

             * Öğrenci kendi rolünü değiştiremez.
             */

            allow update:

                if signedIn()
                &&
                (
                    isTeacher()
                    ||
                    (
                        request.auth.uid == userId
                        &&
                        request.resource.data.uid
                        ==
                        resource.data.uid
                        &&
                        request.resource.data.email
                        ==
                        resource.data.email
                        &&
                        request.resource.data.role
                        ==
                        resource.data.role
                    )
                );


            /*
             * Sadece admin kullanıcı silebilir.
             */

            allow delete:

                if isAdmin();

        }



        /* =================================================
           COURSES
        ================================================= */

        match /courses/{courseId} {

            /*
             * Giriş yapan herkes dersleri görebilir.
             */

            allow read:

                if signedIn();


            /*
             * Öğretmen ve admin ders oluşturabilir.
             */

            allow create:

                if isTeacher();


            /*
             * Öğretmen/admin ders değiştirebilir.
             */

            allow update:

                if isTeacher();


            /*
             * Öğretmen/admin ders silebilir.
             */

            allow delete:

                if isTeacher();

        }



        /* =================================================
           LESSONS
        ================================================= */

        match /lessons/{lessonId} {

            allow read:

                if signedIn();


            allow create:

                if isTeacher();


            allow update:

                if isTeacher();


            allow delete:

                if isTeacher();

        }



        /* =================================================
           TESTS
        ================================================= */

        match /tests/{testId} {

            /*
             * Öğrenci ve öğretmen testleri okuyabilir.
             */

            allow read:

                if signedIn();


            allow create:

                if isTeacher();


            allow update:

                if isTeacher();


            allow delete:

                if isTeacher();

        }



        /* =================================================
           RESULTS
        ================================================= */

        match /results/{resultId} {

            /*
             * Öğrenci yalnızca kendi UID'si adına
             * sınav sonucu oluşturabilir.
             */

            allow create:

                if signedIn()
                &&
                request.resource.data.studentId
                ==
                request.auth.uid;


            /*
             * Öğrenci kendi sonucunu,
             * öğretmen/admin bütün sonuçları
             * okuyabilir.
             */

            allow read:

                if signedIn()
                &&
                (
                    resource.data.studentId
                    ==
                    request.auth.uid
                    ||
                    isTeacher()
                );


            /*
             * Sonuçları öğretmen/admin düzenleyebilir.
             */

            allow update:

                if isTeacher();


            /*
             * Sonuçları öğretmen/admin silebilir.
             */

            allow delete:

                if isTeacher();

        }



        /* =================================================
           ANNOUNCEMENTS
        ================================================= */

        match /announcements/{announcementId} {

            /*
             * Giriş yapan öğrenciler görebilir.
             */

            allow read:

                if signedIn();


            /*
             * Öğretmen/admin duyuru oluşturabilir.
             */

            allow create:

                if isTeacher();


            allow update:

                if isTeacher();


            allow delete:

                if isTeacher();

        }



        /* =================================================
           HER ŞEYİ KAPAT
        ================================================= */

        match /{document=**} {

            allow read, write:

                if false;

        }

    }
}
```
