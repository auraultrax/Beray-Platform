rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Bu ilk paket öğrenci ve öğretmen başvuru kayıtlarını yönetir.
    // Admin sistemi geldiğinde admin yetkileri ayrıca eklenecek.

    match /users/{uid} {
      allow create, update: if isSelf(uid);
      allow read: if isSelf(uid);
      allow delete: if false;
    }

    match /students/{uid} {
      allow create: if isSelf(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == "student";

      allow read: if isSelf(uid);

      allow update: if isSelf(uid)
        && request.resource.data.uid == resource.data.uid;

      allow delete: if false;
    }

    match /teacherApplications/{uid} {
      allow create: if isSelf(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "pending";

      allow read: if isSelf(uid);

      // Başvuruyu kullanıcı tekrar güncelleyebilir ama admin alanlarına
      // istemci tarafından dokunamaz.
      allow update: if isSelf(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.status == resource.data.status
        && request.resource.data.verificationStep == resource.data.verificationStep;

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
